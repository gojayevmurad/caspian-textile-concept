# Add to the central Caddy config (owner approval required). Cloudflare proxies in front (SSL: Full (strict)).
caspian.muradgojayev.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Only trust Cloudflare's forwarded client IP (rate limiting uses it).
	reverse_proxy caspian-textile-app:3000 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}
}
