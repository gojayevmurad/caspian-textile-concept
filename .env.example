# pnpm setup generates private per-project values from this template.
# Do not copy development credentials into production.
# Drizzle loads .env.local when available; exported values take precedence.
APP_URL=http://localhost:3000
DATABASE_URL=postgres://starter:starter@localhost:5432/starter
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to sandbox. Configure a Pro custom benefit on ALL paid products.
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_MONTHLY_PRODUCT_ID=
POLAR_YEARLY_PRODUCT_ID=
POLAR_LIFETIME_PRODUCT_ID=
POLAR_PRO_BENEFIT_ID=
# Preview emails are stored locally in PostgreSQL; never sent.
EMAIL_MODE=preview
EMAIL_FROM=Starter <onboarding@resend.dev>
RESEND_API_KEY=
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_RELEASE=
# Public values are baked into the client bundle at build time.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=
# Build-only source-map upload credentials. Never pass as Docker ARG.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Isolated database only. Name MUST end in _test.
TEST_DATABASE_URL=postgres://starter:starter@localhost:5433/starter_test

# --- Caspian Textile concept ---
# Keep "false" for the demo: adds X-Robots-Tag noindex + robots meta + Disallow.
SITE_INDEXABLE=false
# Processed media variants (Docker volume in production).
MEDIA_DIR=storage/media
# RFQ notifications go ONLY to this address (the applicant), never to the company.
NOTIFY_EMAIL=
# Optional: purge Cloudflare cache after admin publishes (token scoped to Cache Purge only).
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# Optional: admin "AI draft translation" button.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
